{
  "manifest_version": 3,
  "name": "Walmart Product Data Grabber",
  "version": "1.2",
  "description": "Extracts clean JSON product data from the retail page you are viewing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrape this product page"
    
  }
}
